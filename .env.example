# Invy Configuration
# Copy this to .env and fill in your values

# ===================
# LOCAL DEVELOPMENT
# ===================

# Server
PORT=3010
NODE_ENV=development

# Database (local PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=invy

# CORS - allowed origins for API requests
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# API Token (for initial setup, generate via CLI)
# INVY_INITIAL_TOKEN=invy_xxxxxxxxxxxxxxxx

# ===================
# WEBAPP
# ===================

# API URL for the webapp to call
VITE_API_URL=http://localhost:3010/api/v1

# ===================
# AWS DEPLOYMENT
# ===================
# AWS credentials are NOT stored here - use AWS CLI instead:
#   aws configure
# Or set these environment variables in your shell:
#   AWS_ACCESS_KEY_ID
#   AWS_SECRET_ACCESS_KEY
#   AWS_REGION
#
# For Lambda, database credentials are stored in AWS SSM Parameter Store:
#   /invy/{stage}/db/host
#   /invy/{stage}/db/port
#   /invy/{stage}/db/username
#   /invy/{stage}/db/password
#   /invy/{stage}/db/database
#   /invy/{stage}/allowed-origins
