# Invy Configuration
# Copy this to .env and fill in your values

# ===================
# LOCAL DEVELOPMENT
# ===================

# Server
PORT=3010
NODE_ENV=development

# Database (local PostgreSQL - when running API outside Docker)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=invy_admin
DB_PASSWORD=invy_secret
DB_DATABASE=invy

# CORS - allowed origins for API requests
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# API Token (for initial setup, generate via CLI)
# INVY_INITIAL_TOKEN=invy_xxxxxxxxxxxxxxxx

# Blnk Integration (API config)
BLNK_ENABLED=true
BLNK_URL=http://localhost:5001

# ===================
# WEBAPP
# ===================

# API URL for the webapp to call
VITE_API_URL=http://localhost:3010/api/v1

# ===================
# DOCKER COMPOSE
# ===================

# PostgreSQL
POSTGRES_USER=invy_admin
POSTGRES_PASSWORD=invy_secret
POSTGRES_DB=invy
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Typesense
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=typesense_api_key

# Blnk
BLNK_PORT=5001
BLNK_WORKER_PORT=5004
BLNK_TYPESENSE_KEY=typesense_api_key
BLNK_TOKENIZATION_SECRET=invy-blnk-secret-32-bytes-ok!!

# ===================
# AWS DEPLOYMENT
# ===================
# AWS credentials are NOT stored here - use AWS CLI instead:
#   aws configure
# Or set these environment variables in your shell:
#   AWS_ACCESS_KEY_ID
#   AWS_SECRET_ACCESS_KEY
#   AWS_REGION
#
# For Lambda, database credentials are stored in AWS SSM Parameter Store:
#   /invy/{stage}/db/host
#   /invy/{stage}/db/port
#   /invy/{stage}/db/username
#   /invy/{stage}/db/password
#   /invy/{stage}/db/database
#   /invy/{stage}/allowed-origins
